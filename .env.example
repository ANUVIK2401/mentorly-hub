# Copy to .env.local for local development. Never commit real secrets.

# REQUIRED to enable /admin in production. There is intentionally NO default password in production.
# (In `npm run dev` the admin password is "admin" if this is unset.)
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate one with:  openssl rand -hex 32
# If unset, ADMIN_PASSWORD is used as the signing key (works, but a separate value is better).
SESSION_SECRET=

# Optional. Number of synthetic projects to generate, 1 to 1152. Default 240.
SEED_COUNT=240

# Roadmap Phase 1 (not used yet). Use the POOLED connection string on serverless.
# DATABASE_URL=postgres://user:password@host:6543/postgres

# Public origin used in links inside emails. Defaults to the Vercel production URL, then localhost.
# SITE_URL=https://your-domain.example

# Local only: print outgoing emails (recipient and body) to the console. Never set on a deployment.
# MAIL_DEBUG=1
